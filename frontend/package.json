{
	"name": "adventurelog-frontend",
	"version": "0.13.1",
	"packageManager": "pnpm@10.32.1",
	"scripts": {
		"dev": "vite dev",
		"django": "cd .. && cd backend/server && python3 manage.py runserver",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"api:types": "openapi-typescript ../backend/server/openapi/schema.yaml -o src/lib/api/schema.d.ts",
		"test": "vitest run",
		"test:unit": "vitest run --project unit",
		"test:component": "vitest run --project component --passWithNoTests",
		"test:coverage": "vitest run --project unit --coverage",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@event-calendar/core": "^5.18.1",
		"@iconify-json/mdi": "^1.2.3",
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/adapter-vercel": "^7.0.1",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^22.15.2",
		"@types/qrcode": "^1.5.5",
		"@vitest/browser-playwright": "^5.1.0",
		"@vitest/coverage-v8": "^5.1.0",
		"baseline-browser-mapping": "^2.11.33",
		"daisyui": "^5.7.50",
		"openapi-typescript": "7.13.0",
		"prettier": "^3.5.3",
		"prettier-plugin-svelte": "^3.3.3",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"unplugin-icons": "^24.0.0",
		"vite": "^8.3.5",
		"vitest": "^5.1.0",
		"vitest-browser-svelte": "^3.1.0"
	},
	"type": "module",
	"engines": {
		"node": ">=22.17 <27"
	},
	"dependencies": {
		"@lukulent/svelte-umami": "^0.0.4",
		"cally": "^0.9.2",
		"dompurify": "^3.4.17",
		"emoji-picker-element": "^1.26.3",
		"gsap": "^3.15.0",
		"layerchart": "^2.8.0",
		"luxon": "^3.6.1",
		"maplibre-gl": "^6.16.0",
		"marked": "^15.0.11",
		"psl": "^1.15.0",
		"qrcode": "^1.5.4",
		"svelte-dnd-action": "^0.9.80",
		"svelte-i18n": "^4.0.1",
		"svelte-maplibre": "^2.0.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}

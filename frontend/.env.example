# Optional — uncomment and edit as needed
# ═══════════════════════════════════════════════════════

# ── Umami analytics ─────────────────────────────────────
# Docs: https://adventurelog.app/docs/configuration/analytics.html
# PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
# PUBLIC_UMAMI_WEBSITE_ID=

# AdventureLog — Frontend (local development)
# Copy to .env: cp .env.example .env
# Used when running `pnpm dev` from frontend/

# ── Backend API ─────────────────────────────────────────
PUBLIC_SERVER_URL=http://127.0.0.1:8000
BODY_SIZE_LIMIT=Infinity


